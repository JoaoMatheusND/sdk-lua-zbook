menuconfig ZBOOK_LUA
	bool "ZBook Lua binding"
	depends on LUA
	help
	  Expose the ZBook interface to Lua scripts as the global `zbook`
	  table (zbook.<category>.<peripheral>). Requires the lua_zephyr
	  runtime (CONFIG_LUA).

if ZBOOK_LUA

config ZBOOK_LUA_LIBC_STUBS
	bool "Weak POSIX file I/O stubs for the Lua core"
	default y if PICOLIBC && !POSIX_DEVICE_IO
	help
	  Provide weak open/close/read/write/lseek stubs failing with ENOSYS so
	  the Lua core (liolib, luaL_loadfilex) links against Picolibc without
	  Zephyr's POSIX device I/O layer. Zephyr SDK >= 1.0 ships Picolibc
	  only. Disabled automatically when POSIX_DEVICE_IO is enabled.

menu "Actuators"

config ZBOOK_LUA_LED
	bool "zbook.actuators.led"
	default y
	select ZBOOK_INTERFACE_ACTUATORS
	select ZBOOK_INTERFACE_ACTUATORS_LED
	help
	  Expose zbook_led_* to Lua as zbook.actuators.led.

endmenu

menu "I/O"

config ZBOOK_LUA_BTN
	bool "zbook.io.btn"
	default y
	select ZBOOK_INTERFACE_IO
	select ZBOOK_INTERFACE_IO_BTN
	help
	  Expose zbook_btn_* to Lua as zbook.io.btn. Button events are
	  published on the zbus channel zbook_lua_btn_chan and consumed from
	  Lua with btn.wait() (or zephyr.zbus.observer_declare("zbook_lua_btn_sub")).

config ZBOOK_LUA_BTN_QUEUE_TIMEOUT_MS
	int "Button event publish timeout (ms)"
	default 0
	depends on ZBOOK_LUA_BTN
	help
	  How long the button callback may block publishing an event. 0 drops
	  the event immediately if it cannot be queued.

endmenu

endif # ZBOOK_LUA
